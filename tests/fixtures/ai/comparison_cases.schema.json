{
  "type": "object",
  "required": [
    "name",
    "domain",
    "mode",
    "prompt",
    "reference_answer",
    "rubric_family",
    "user_role",
    "evidence_chunks",
    "baseline",
    "candidate",
    "pairwise_forward_response",
    "pairwise_flipped_response",
    "expected_winner",
    "expected_order_consistent"
  ],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "domain": { "type": "string", "minLength": 1, "maxLength": 64 },
    "mode": { "type": "string", "enum": ["instant", "thinking", "extended"] },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 512 },
    "reference_answer": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "rubric_family": { "type": "string", "enum": ["response_quality"] },
    "user_role": { "type": "string", "enum": ["user", "admin"] },
    "evidence_chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "text", "visibility"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "visibility": { "type": "string", "enum": ["user", "shared", "admin"] }
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": ["label", "model_id", "prompt_version", "assistant_answer"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "prompt_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "assistant_answer": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["label", "model_id", "prompt_version", "assistant_answer"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "prompt_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "assistant_answer": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "pairwise_forward_response": {
      "type": "object",
      "required": ["winner", "confidence", "reason"],
      "additionalProperties": false,
      "properties": {
        "winner": { "type": "string", "enum": ["a", "b", "tie", "no_winner"] },
        "confidence": { "type": "number" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "pairwise_flipped_response": {
      "type": "object",
      "required": ["winner", "confidence", "reason"],
      "additionalProperties": false,
      "properties": {
        "winner": { "type": "string", "enum": ["a", "b", "tie", "no_winner"] },
        "confidence": { "type": "number" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "expected_winner": {
      "type": "string",
      "enum": ["baseline", "candidate", "tie", "no_winner"]
    },
    "expected_order_consistent": { "type": "boolean" }
  }
}
