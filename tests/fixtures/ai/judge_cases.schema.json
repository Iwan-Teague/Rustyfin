{
  "type": "object",
  "required": [
    "name",
    "domain",
    "mode",
    "prompt",
    "assistant_answer",
    "reference_answer",
    "rubric_family",
    "user_role",
    "evidence_chunks",
    "rubric_response",
    "human_labels",
    "expected_rubric_pass",
    "expected_review_required",
    "expected_calibration_agreement"
  ],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "domain": { "type": "string", "minLength": 1, "maxLength": 64 },
    "mode": { "type": "string", "enum": ["instant", "thinking", "extended"] },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 512 },
    "assistant_answer": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "reference_answer": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "rubric_family": { "type": "string", "enum": ["response_quality"] },
    "user_role": { "type": "string", "enum": ["user", "admin"] },
    "evidence_chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "text", "visibility"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "visibility": { "type": "string", "enum": ["user", "shared", "admin"] }
        }
      }
    },
    "rubric_response": {
      "type": "object",
      "required": ["dimensions", "overall_reason"],
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["dimension", "pass", "score", "confidence", "reason"],
            "additionalProperties": false,
            "properties": {
              "dimension": {
                "type": "string",
                "enum": ["concision", "clarity", "groundedness", "completeness"]
              },
              "pass": { "type": "boolean" },
              "score": { "type": "number" },
              "confidence": { "type": "number" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "overall_reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "human_labels": {
      "type": "object",
      "required": ["consensus_pass", "consensus_score", "dimensions"],
      "additionalProperties": false,
      "properties": {
        "consensus_pass": { "type": "boolean" },
        "consensus_score": { "type": "number" },
        "dimensions": {
          "type": "object",
          "required": ["concision", "clarity", "groundedness", "completeness"],
          "additionalProperties": false,
          "properties": {
            "concision": {
              "type": "object",
              "required": ["pass", "score"],
              "additionalProperties": false,
              "properties": {
                "pass": { "type": "boolean" },
                "score": { "type": "number" }
              }
            },
            "clarity": {
              "type": "object",
              "required": ["pass", "score"],
              "additionalProperties": false,
              "properties": {
                "pass": { "type": "boolean" },
                "score": { "type": "number" }
              }
            },
            "groundedness": {
              "type": "object",
              "required": ["pass", "score"],
              "additionalProperties": false,
              "properties": {
                "pass": { "type": "boolean" },
                "score": { "type": "number" }
              }
            },
            "completeness": {
              "type": "object",
              "required": ["pass", "score"],
              "additionalProperties": false,
              "properties": {
                "pass": { "type": "boolean" },
                "score": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "expected_rubric_pass": { "type": "boolean" },
    "expected_review_required": { "type": "boolean" },
    "expected_calibration_agreement": { "type": "boolean" }
  }
}
