{
  "type": "object",
  "required": [
    "name",
    "user_role",
    "message",
    "history",
    "model_responses",
    "expected_tools",
    "expected_mode"
  ],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "user_role": { "type": "string", "enum": ["user", "admin"] },
    "message": { "type": "string", "minLength": 1, "maxLength": 512 },
    "history": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "additionalProperties": true,
        "properties": {
          "role": { "type": "string" },
          "content": { "type": "string" },
          "grounding_chunks": { "type": "array" }
        }
      }
    },
    "model_responses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 2, "maxLength": 4096 }
    },
    "expected_tools": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "expected_mode": {
      "type": "string",
      "enum": ["deterministic_fallback", "model_structured"]
    },
    "forbidden_tools": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
