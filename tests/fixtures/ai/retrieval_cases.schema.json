{
  "type": "object",
  "required": ["name", "question", "required_evidence_ids", "chunks"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "user_role": { "type": "string", "enum": ["user", "admin"] },
    "question": { "type": "string", "minLength": 1, "maxLength": 512 },
    "required_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "source_kind", "title", "excerpt", "score", "visibility"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "source_kind": { "type": "string", "minLength": 1, "maxLength": 128 },
          "title": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "score": { "type": "number" },
          "visibility": { "type": "string", "enum": ["user", "shared", "admin"] },
          "topic_key": { "type": "string", "maxLength": 256 },
          "source_id": { "type": "string", "maxLength": 256 },
          "source_sub_id": { "type": "string", "maxLength": 256 }
        }
      }
    }
  }
}
