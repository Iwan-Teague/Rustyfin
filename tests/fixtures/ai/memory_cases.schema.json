{
  "type": "object",
  "required": [
    "name",
    "history",
    "memory_chunks",
    "question",
    "expected_fact_substring",
    "expected_topic"
  ],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "user_role": { "type": "string", "enum": ["user", "admin"] },
    "history": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "additionalProperties": true,
        "properties": {
          "role": { "type": "string" },
          "content": { "type": "string" },
          "grounding_chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "source_kind", "title", "excerpt", "score", "visibility"],
              "additionalProperties": true,
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "source_kind": { "type": "string", "minLength": 1, "maxLength": 128 },
                "title": { "type": "string", "minLength": 1, "maxLength": 2048 },
                "excerpt": { "type": "string", "minLength": 1, "maxLength": 2048 },
                "score": { "type": "number" },
                "visibility": { "type": "string", "enum": ["user", "shared", "admin"] }
              }
            }
          }
        }
      }
    },
    "memory_chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "source_kind", "title", "excerpt", "score", "visibility"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "source_kind": { "type": "string", "minLength": 1, "maxLength": 128 },
          "title": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "score": { "type": "number" },
          "visibility": { "type": "string", "enum": ["user", "shared", "admin"] }
        }
      }
    },
    "question": { "type": "string", "minLength": 1, "maxLength": 512 },
    "expected_fact_substring": { "type": "string", "minLength": 1, "maxLength": 256 },
    "expected_topic": { "type": "string", "minLength": 1, "maxLength": 256 },
    "expected_preference_substring": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
